@model List<Product>
@{
    ViewData["Title"] = "Home Page";
    var banners = (List<Banner>)ViewBag.Banners;
    var hero = banners.FirstOrDefault();
}
<div class="hero">
    <div class="container">
        <p class="text-uppercase">@(hero?.Name ?? "Amet nunc et accumsan blandit")</p>
        <h1>@(hero?.Description ?? "Metus purus pharetra sit")</h1>
        <a class="btn btn-primary" href="#products">Xem sản phẩm</a>
    </div>
</div>
<div class="container py-5" id="products">
    <h4 class="text-center text-uppercase mb-4">Sản phẩm mới</h4>
    <div class="row">
        @foreach (var p in Model)
        {
            <div class="col-md-4 mb-4">
                <div class="card h-100 text-center">
                    <div class="card-body">
                        <h6 class="text-uppercase">@p.Name</h6>
                        <p class="text-muted mb-1">@p.Category?.Name</p>
                        <p>
                            @if (p.SalePrice > 0)
                            {
                                <del>@p.Price.ToString("N0")</del> <strong class="text-danger">@p.SalePrice.ToString("N0")</strong>
                            }
                            else
                            {
                                <strong>@p.Price.ToString("N0")</strong>
                            }
                        </p>
                        <a href="#" class="btn btn-sm btn-primary">Read More</a>
                    </div>
                </div>
            </div>
        }
    </div>
</div>
